# Copy to .env for the API. Values below are examples/placeholders, never secrets.
# Variable purpose, defaults, requirements, and visibility: README.md → Environment reference.
# Frontend public Firebase Authentication configuration (safe to expose in the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-roofing-local
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# API/runtime settings.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
REQUEST_TIMEOUT_SECONDS=60
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Firebase Admin and Firestore. Supply ADC or a backend-only service-account path.
FIREBASE_PROJECT_ID=demo-roofing-local
FIRESTORE_DATABASE_ID=(default)
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional backend-only NVIDIA NIM credential. No value is committed.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_TIMEOUT_SECONDS=120
NVIDIA_MAX_RETRIES=2
NVIDIA_REASONING_BUDGET=16384
NVIDIA_MAX_OUTPUT_TOKENS=65536
MALFORMED_OUTPUT_RETRIES=1
EXTRACTION_SCHEMA_VERSION=2
EXTRACTION_PROMPT_VERSION=2

# Upload and Firestore chunk controls.
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=100
MAX_ESTIMATE_LINE_ITEMS=100
MAX_MATERIAL_SELECTIONS=30
FILE_CHUNK_SIZE_BYTES=524288
FIRESTORE_CHUNK_BATCH_SIZE=8
FIRESTORE_DELETE_BATCH_SIZE=400
UPLOAD_STALE_AFTER_SECONDS=900
JOB_STALE_AFTER_SECONDS=1800
JOB_POLL_INTERVAL_SECONDS=2
JOB_POLL_TIMEOUT_SECONDS=180
MAX_ARTIFACT_BYTES=20971520
GEOMETRY_INLINE_LIMIT_BYTES=409600
UPLOAD_READ_SIZE_BYTES=65536
FIREBASE_RETRY_ATTEMPTS=3
JOB_MAX_CONCURRENCY=2

# Geometry extraction, calibration, validation, and page rendering.
GEOMETRY_PITCH_TOLERANCE_DEGREES=1
GEOMETRY_SNAP_TOLERANCE_POINTS=0.8
GEOMETRY_SCALE_TOLERANCE_PERCENT=3
GEOMETRY_FACET_AREA_TOLERANCE_PERCENT=5
GEOMETRY_EDGE_CLASS_TOLERANCE_PERCENT=3
GEOMETRY_HEIGHT_TOLERANCE_FEET=0.05
GEOMETRY_WALL_DEPTH_FEET=8
GEOMETRY_PAGE_RENDER_DPI=144

# Estimation defaults. These are editable defaults, not legal/tax guidance.
DEFAULT_CURRENCY=CAD
DEFAULT_TAX_RATE=0
DEFAULT_WASTE_PERCENTAGE=8
DEFAULT_MARKUP_PERCENTAGE=0
